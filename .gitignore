# Secret (publish token, Nominatim contact email) — never in the repo,
# only on the server. See art-actu.php's header comment.
config.php

# Runtime data, regenerated by the weekly n8n workflow / rebuilt on demand.
exhibitions.db
exhibitions.db-wal
exhibitions.db-shm

# Installed by `npm install` in scripts/ (see scripts/render-logo-pngs.js).
scripts/node_modules
scripts/package-lock.json

# Rasterised from logos/*.svg by scripts/render-logo-pngs.js — regenerate
# with `npm install && npm run render` inside scripts/ rather than
# committing binary PNGs to the repo.
logos-png/
geocode_cache.json
